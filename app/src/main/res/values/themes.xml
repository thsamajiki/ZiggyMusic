<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.ZiggyMusic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>

        <!-- Default text style -->
        <item name="android:textViewStyle">@style/Widget.ZiggyMusic.TextView</item>

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>

        <item name="android:statusBarColor">@color/main_background_gradient_start</item>
        <item name="android:navigationBarColor">@color/main_background_gradient_start</item>
        <item name="android:windowBackground">@color/main_background_gradient_start</item>
    </style>

    <style name="Theme.ZiggyMusic" parent="Base.Theme.ZiggyMusic" />

    <style name="Theme.ZiggyMusic.Launcher" parent="Theme.ZiggyMusic" />
</resources>
